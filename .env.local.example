# Notion API
NOTION_API_KEY=

# Notion DATABASE
NOTION_PROJECTS_DATABASE_ID=
NOTION_BLOG_DATABASE_ID=
NOTION_COMMENTS_DATABASE_ID=

#NEXT
NEXT_PUBLIC_SITE_URL=http://localhost:3003
NEXT_PUBLIC_SITE_NAME="Personal Brand Website"
NEXT_PUBLIC_SITE_DESCRIPTION="A modern portfolio and blog website built with Next.js and Notion API"

#EMAILJS
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Development options
DISABLE_NOTION_CACHE=true
NEXT_PUBLIC_GA_ID=

# Google AdSense (自动广告不需要额外配置)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# 手动刷新拉取首页底部文章
REVALIDATE_SECRET=REVALIDATE_SECRET

# 订阅系统 (邮件订阅 + Web Push)
NOTION_SUBSCRIBERS_DATABASE_ID=

# Resend 邮件 (不填则走控制台打印降级)
RESEND_API_KEY=
RESEND_FROM="MisoTech <noreply@example.com>"

# Web Push VAPID (web-push generate-vapid-keys 生成)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=noreply@example.com

# 内容状态机 + 定时发布 (feat-content-state-machine-20260811)
# 草稿预览 token 密钥;不配置时降级为进程随机密钥 + 控制台打印预览链接
PREVIEW_TOKEN=
# cron 定时发布密钥;不配置时 /api/cron/publish 拒绝运行(401)
CRON_SECRET=
# 内容管理后台 http://localhost:3000/admin/content token;不配置时仅允许 localhost 访问并控制台告警
ADMIN_TOKEN=

# 评论治理 + 站长邮箱
COMMENT_NOTIFY_TO=noreply@example.com

# ─── 发布管线 feat-publish-pipeline(CLI: npm run blog:publish -- <post.md>;网页: /admin/publish) ───

# GitHub 图床:图片上传到独立公开仓库,外链走 jsDelivr(发布页跑在 Vercel 上,无法 git push,故走 Contents API)
# PAT 需要 repo 权限: https://github.com/settings/tokens
GITHUB_TOKEN=
# 图床仓库(格式 owner/name,建议新建公开仓库如 misotech-images)
IMAGE_REPO=
# 图床分支(默认 main)
IMAGE_BRANCH=main
# 图片外链前缀(默认 https://cdn.jsdelivr.net/gh/<IMAGE_REPO>@<IMAGE_BRANCH>;将来换 COS/R2 只改这里)
IMG_CDN_BASE=

# AI 三件套(Blog 全字段 + 封面文生图提示词×3 + Twitter 推文)
# GLM 普通 Key 用默认 https://open.bigmodel.cn/api/paas/v4
# GLM Coding Plan 的 Key 用 https://open.bigmodel.cn/api/coding/paas/v4
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4.6
AI_TIMEOUT_MS=120000

# 发布默认署名(写入 Blog 库 AuthorText 属性,frontmatter author 可覆盖)
AUTHOR_NAME=Archer
# ButtonAllUpdate(url 属性)填充的链接;缺省用 NEXT_PUBLIC_SITE_URL + REVALIDATE_SECRET 拼接
BUTTON_ALL_UPDATE_URL=